# ───────────────────────────────────────────────────────────────────────────────
# SGI Scraper — Configuración de entorno
# ───────────────────────────────────────────────────────────────────────────────
# Copiá este archivo como ".env" y completá con tus datos reales.
# NUNCA subas el archivo .env a un repositorio.
# ───────────────────────────────────────────────────────────────────────────────

# ── Credenciales SGI ──────────────────────────────────────────────────────────
SGI_USER=tu_usuario_sgi
SGI_PASS=tu_contraseña_sgi
SGI_URL=https://sgi.swissmedical.com.ar/sgi-app/#index

# ── Google Sheets ─────────────────────────────────────────────────────────────
# ID de la planilla (está en la URL: /d/[ESTE_ID]/edit)
SPREADSHEET_ID=tu_spreadsheet_id_aqui

# Nombre exacto de la hoja/pestaña (respeta mayúsculas y espacios)
SHEET_NAME=Hoja 1

# Ruta al archivo de credenciales de Google Service Account
GOOGLE_CREDENTIALS_PATH=./credentials.json

# ── Configuración de ejecución ───────────────────────────────────────────────
# Mostrar el navegador (true) o ejecutar en modo headless (false)
SHOW_BROWSER=true

# Milisegundos de espera entre cada trámite (recomendado: 2000-5000)
DELAY_BETWEEN=3000

# Fila de inicio (2 = saltea el header)
START_ROW=2

# ── Debug ─────────────────────────────────────────────────────────────────────
# Activar modo debug (muestra stack traces completos)
DEBUG=false
